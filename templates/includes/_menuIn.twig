{# ================================================================
   LOGO + MENÜ ADATOK BETÖLTÉSE
================================================================ #}

{% set headerGlobal = craft.app.globals.getSetByHandle('header') ?? null %}
{% set logo = headerGlobal and headerGlobal.image|length ? headerGlobal.image.one() : null %}

{% set menuItems = craft.entries.section('menu').all() %}
{% set baseUrl = craft.app.request.getHostInfo() %}

{% set formattedMenu = [] %}

{% for item in menuItems %}

    {% set type = (item.optional ?? '')|lower %}
    {% set url  = '#' %}
    {% set slug = null %}

    {# --------- LINK + SLUG FELTÖLTÉS --------- #}

    {% if type == 'post' and item.post|length %}
        {# menüpont egy bejegyzésre mutat #}
        {% set target = item.post.one() %}
        {% set url    = target.url %}
        {% set slug   = target.slug %}

    {% elseif type == 'category' and item.catField|length %}
        {# menüpont kategóriára mutat #}
        {% set target = item.catField.one() %}
        {% set url    = target.url %}
        {% set slug   = target.slug %}

    {% elseif type == 'directlink' and item.directLink %}
        {# közvetlen link #}
        {% set url = item.directLink %}
        {# slug a cím alapján, ékezetmentesítve #}
        {% set slug = item.title
            |lower
            |replace({
                'á':'a','é':'e','í':'i','ó':'o','ö':'o','ő':'o','ú':'u','ü':'u','ű':'u'
            })
            |replace({
                ' ':'',
                '-':''
            })
        %}

    {% else %}
        {# fallback: slug a cím alapján #}
        {% set slug = item.title
            |lower
            |replace({
                'á':'a','é':'e','í':'i','ó':'o','ö':'o','ő':'o','ú':'u','ü':'u','ű':'u'
            })
            |replace({
                ' ':'',
                '-':''
            })
        %}
    {% endif %}

    {# külső link-e? #}
    {% set isExternal = url matches '~^https?://~' and not (url starts with baseUrl) %}

    {# MENÜ ELEM JSON #}
    {% set formattedMenu = formattedMenu|merge([
        {
            title: item.title,
            url: url,
            external: isExternal,
            slug: slug
        }
    ]) %}
{% endfor %}

{# ========================= LANGUAGE HTML ======================== #}
{% set languageHtml %}
    {% include './includes/_language.twig' %}
{% endset %}

{# ================================================================
   INNER HEADER MOUNT POINT
================================================================ #}

<div id="site-header"
     data-logo-url="{{ logo ? logo.url : '' }}"
     data-logo-alt="{{ logo ? (logo.alt ?? logo.title ?? siteName) : '' }}"
     data-language="{{ languageHtml|e('html_attr') }}"
     data-menu='{{ formattedMenu|json_encode }}'
     data-mode="inner"
></div>
