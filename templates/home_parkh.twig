{% extends "_layout_parkh" %}

{% set pageTitle = entry.title %}

{# ============================================
   BLOCK MENU  →  FEJLÉC + STICKY MOBIL + SLIDER
=============================================== #}
{% block menu %}

  {% import '_macros/icons.twig' as icons %}

  {# Globál header #}
  {% set header = craft.app.globals.getSetByHandle('header') ?? null %}
  {% if not header %}
    {% set header = { textBox: '', button: null } %}
  {% endif %}

  {# Ikon (mobil alsó sávhoz) #}
  {% set iconName = header.iconName ?? null %}
  {% set iconSet = null %}
  {% if iconName %}
    {% if craft.app.view.doesTemplateExist('includes/icons/heroicons/' ~ iconName ~ '.svg') %}
      {% set iconSet = 'heroicons' %}
    {% elseif craft.app.view.doesTemplateExist('includes/icons/brands/' ~ iconName ~ '.svg') %}
      {% set iconSet = 'brands' %}
    {% endif %}
  {% endif %}
  {% set iconHtml = iconSet ? icons.icon(iconName, iconSet, 'w-6 h-6 text-white') : '' %}

  {# 1) FIXEN A TETEJÉN LÉVŐ MOBIL MENÜ #}
<div class="block md:hidden fixed top-0 left-0 w-full z-50 bg-primary">
  <nav aria-label="{{ 'Fő navigáció'|t }}">
    {% include './includes/_menu.twig' with { id: 'mobile-header' } %}
  </nav>
</div>
  <div class="block md:hidden h-[72px]"></div>

  {# ==========================================================
     FEJLÉC + SLIDER BLOKK
  =========================================================== #}
  <div class="w-full bg-white p-2 md:p-5">
    <section class="mx-auto bg-primary text-white rounded-xl md:rounded-2xl lg:rounded-4xl overflow-visible pb-16 md:pb-0"


             aria-labelledby="home-hero-title">
      <div class="max-w-10xl mx-auto">

<!-- Felső sor -->
<div class="flex flex-row sm:flex sm:items-center justify-between gap-4 px-5 lg:px-10 2xl:px-20">

  <!-- Desktop menü -->
  <div class="hidden md:block w-full">
    {% include './includes/_menu.twig' with { id: 'site-header' } %}
  </div>

  <!-- Bal oldali adat blokk -->
  <div class="w-3/4 sm:w-auto flex flex-col sm:flex-row gap-2 sm:gap-4">
  </div>

  <!-- Nyelvváltó -->


</div>


        <!-- Hero két oszlop -->
        <div class="flex flex-col lg:flex-row items-stretch">


          <!-- BAL OSZLOP -->
          <div class="w-full lg:w-2/5 min-w-0 p-5 lg:px-10 2xl:px-20
                      grid grid-rows-[auto_1fr_auto] min-h-0
                      break-words [hyphens:auto]
                      [&_p]:text-base [&_p]:lg:text-sm [&_p]:2xl:text-base
                      [&_h1]:mb-2 [&_h1]:text-thirdy [&_h1]:text-4xl [&_h1]:lg:text-5xl [&_h1]:xl:text-6xl [&_h1]:2xl:text-8xl [&_h1]:break-words
                      [&_h2]:text-four [&_h2]:mb-2 [&_h2]:lg:mb-3 [&_h2]:xl:mb-4 [&_h2]:2xl:mb-5
                      [&_h2]:text-2xl [&_h2]:lg:text-3xl [&_h2]:xl:text-4xl [&_h2]:2xl:text-6xl [&_h2]:break-words">

            <div class="self-start">
              <div class="order-2 sm:order-1 w-full min-w-0 max-w-full flex items-center gap-2
                          text-base sm:group-[.shrink]:gap-1 sm:group-[.shrink]:text-sm
                          transition-all duration-300 motion-reduce:transition-none">
                {% include './includes/_iconsData.twig' with { id: 'mobile-header' } %}
              </div>
            </div>

            <div class="self-center min-w-0">
              <h1 id="home-hero-title" class="sr-only">{{ siteName }}</h1>
              {{ header.textBox }}
            </div>

            {# Gomb a header.button-ból #}

            <div class="self-end mt-2 hidden md:block">
              <button type="button"
                      class="btn btn--thirdy btn--lineDraw focus:outline-none focus-visible:ring-2 focus-visible:ring-offset-2 focus-visible:ring-white/70 focus-visible:ring-offset-primary text-lg font-bold uppercase"
                      onclick="window.__menuPopup && window.__menuPopup.open()"
                      aria-label="{{ 'Heti menü megnyitása'|t }}">
                {{ 'Heti menü'|t }}
              </button>
            </div>

          </div>



          <!-- Jobb oszlop: Slider -->
          <div class="w-full lg:w-3/5 overflow-hidden rounded-tl-[64px] min-h-0">
            {% include './includes/_slider.twig' %}
          </div>

        </div>
      </div>
    </section>
  </div>

    {# --- Mobil alsó sáv (full-width). Csak akkor rajzoljuk, ha van ikon vagy gomb) --- #}
  {% if iconHtml or (header.button is defined and header.button.one()) %}

      <div class="fixed bottom-0 left-0 w-full bg-primary text-white border-t border-white md:hidden z-50"
          role="region"
          aria-label="{{ 'Gyors művelet'|t }}">
        <div class="flex items-center gap-3 p-2 px-3">
          <button type="button"
                  class="inline-flex items-center gap-2 px-4 py-2 rounded-lg border border-white text-white font-bold text-sm shadow-lg
                        focus:outline-none focus-visible:ring-2 focus-visible:ring-offset-2 focus-visible:ring-white focus-visible:ring-offset-primary"
                  onclick="window.__menuPopup && window.__menuPopup.open()"
                  aria-label="{{ 'Heti menü megnyitása'|t }}">
            {% if iconHtml %}
              <span aria-hidden="true">{{ iconHtml|raw }}</span>
            {% endif %}
            <span>{{ 'Heti menü'|t }}</span>
          </button>
        </div>
      </div> 
 
  {% endif %}

{% endblock %}



{# ============================================
   BLOCK MAIN → HÍREK + ONEPAGE + PICTTEXT + POPUP
=============================================== #}
{% block main %}

  {# ========================
     HÍREK ADATLEKÉRÉS
  ========================= #}
  {% set limit = 6 %}
  {% set allNewsQuery = craft.entries()
    .section('news')
    .type('new')
    .with(['onePict'])
    .orderBy('postDate desc') %}
  {% set totalNews = allNewsQuery.count() %}
  {% set news = allNewsQuery.limit(limit).all() %}

  <section id="home-news" class="py-10" aria-labelledby="home-news-title">
    <div class="max-w-8xl mx-auto px-4 sm:px-6">

      <div class="mb-8 text-center">
        <h2 id="home-news-title" class="text-3xl md:text-4xl lg:text-6xl text-primary">{{ 'Hírek'|t }}</h2>
      </div>

      <!-- Mobil karusszel -->
      <div class="md:hidden" role="region" aria-roledescription="carousel">
        <div class="news-carousel -mx-4 px-4 overflow-x-auto flex gap-4 snap-x snap-mandatory scroll-pl-4"
             role="list"
             data-dots="#news-dots">

          {% for item in news %}
            {% include 'includes/_newsCard.twig' with { item: item } %}
          {% endfor %}

        </div>

        <div id="news-dots" class="flex items-center gap-2 mt-4 justify-center" role="tablist"></div>
      </div>

      <!-- Desktop grid -->
      <div class="hidden md:grid grid-cols-1 md:grid-cols-3 gap-6" role="list">
        {% for item in news|slice(0,3) %}
          {% include 'includes/_newsCard.twig' with { item: item } %}
        {% endfor %}
      </div>

      {% if totalNews > 3 %}
        <div class="mt-6 text-center">
          <a href="{{ url('news') }}"
             class="inline-flex items-center gap-2 px-5 py-3 rounded-full bg-thirdy text-black font-semibold hover:scale-110 transition">
            {{ 'További hírek'|t }}
            <svg class="w-4 h-4" viewBox="0 0 20 20"><path fill="currentColor" d="M7 5l5 5-5 5"/></svg>
          </a>
        </div>
      {% endif %}
    </div>
  </section>


  {# ========================
     ONEPAGE SZEKCIÓK
  ========================= #}
  {% set entries = craft.entries().section('onePage').type('content').all() %}

  {% if entries|length %}
    {% for entry in entries %}
      {% set sectionId = 'onepage-' ~ entry.id %}
      {% set img = entry.onePict.one() ?? null %}
      {% set hasImage = img is not null %}

      {% if hasImage %}
        {% set isLandscape = img.width >= img.height %}
        {% set transform = isLandscape ? { mode: 'crop', width: 1280 } : { mode: 'crop', width: 800 } %}
        {% set imgUrl = img.getUrl(transform) %}
        {% set imgWAttr = img.getWidth(transform) %}
        {% set imgHAttr = img.getHeight(transform) %}
      {% endif %}

      {% set imgW  = hasImage ? (isLandscape ? 'md:w-1/2' : 'md:w-5/12') : 'md:w-0' %}
      {% set textW = hasImage ? (isLandscape ? 'md:w-1/2' : 'md:w-7/12') : 'md:w-full' %}
      {% set imgOrder  = entry.switch ? 'md:order-2' : 'md:order-1' %}
      {% set textOrder = entry.switch ? 'md:order-1' : 'md:order-2' %}

      <section id="{{ sectionId }}" class="max-w-8xl mx-auto px-6 md:px-10 py-6 md:py-10">

        <div class="flex flex-col md:flex-row items-center gap-8 md:gap-14">

          {% if hasImage %}
            <div class="{{ imgW }} w-full {{ imgOrder }}">
              <figure class="rounded-3xl overflow-hidden">
                <img src="{{ imgUrl }}" alt="{{ img.title }}"
                     width="{{ imgWAttr }}" height="{{ imgHAttr }}"
                     class="block w-full h-auto" loading="lazy">
              </figure>
            </div>
          {% endif %}

          <div class="{{ textW }} w-full {{ textOrder }}">
            <!-- h2 class="mb-6 text-primary text-4xl md:text-5xl">{{ entry.title }}</h2 -->

                    <div class="prose max-w-none md:prose-lg">
              {{ entry.textBox|raw }}
            </div>

            {% set target = entry.post.one() %}
            {% if target %}
              <div class="mt-8">
                <a href="{{ target.url }}" rel="bookmark"
                   class="inline-flex items-center justify-center rounded-full bg-primary text-white px-6 py-3 font-semibold tracking-wide hover:bg-primary/90 transition">
                  {{ 'Bővebben'|t }}
                  <span class="sr-only">: {{ target.title }}</span>
                </a>
              </div>
            {% endif %}
          </div>

        </div>

        <div class="w-full my-auto mx-auto">
          {% for block in entry.pictText.all() %}
            {% include '_modules/' ~ block.type %}
          {% endfor %}
        </div>

      </section>

    {% endfor %}
  {% endif %}

  {# ===============================
     MENU POPUP INCLUDE (VÉGÉN)
  ================================ #}
  {% include './includes/_menuPopup.twig' %}

{% endblock %}
