{% if block.type == 'pT' %}
  {% set isImageLeft = block.switch %}
  {% set isCpOn = block.cp %}

  {# Képtömb #}
  {% set images = block.image.all() %}
  {% set mainImage = images|length >= 1 ? images[0] : null %}
  {% set smallImage = images|length >= 2 ? images[1] : null %}

  {% if mainImage %}
    {% set isPortrait = mainImage.height > mainImage.width %}
    {% if isPortrait %}
      {% set mainTransform = isCpOn ? thumb640Hfit : thumb640Hcrop %}
      {% set mainImageWidthClass = 'md:w-[40%]' %}
      {% set textWidthClass = 'md:w-[60%]' %}
    {% else %}
      {% set mainTransform = isCpOn ? thumb1024fit : thumb1024crop %}
      {% set mainImageWidthClass = 'md:w-1/2' %}
      {% set textWidthClass = 'md:w-1/2' %}
    {% endif %}
  {% endif %}

  {% set imageOrder = isImageLeft ? 'md:order-1' : 'md:order-2' %}
  {% set textOrder = isImageLeft ? 'md:order-2' : 'md:order-1' %}
  {% set imageRoundedClass = 'rounded-xl' %}

<div class="max-w-8xl mx-auto"> 
  <div class="flex flex-col md:flex-row md:items-center mb-1">
    
    {# ---- KÉP BLOKK ---- #}
    <div class="relative overflow-visible w-full {{ mainImageWidthClass }} {{ imageOrder }}">
      {% if mainImage %}
        <img 
          src="{{ mainImage.getUrl(mainTransform) }}"
          alt="{{ mainImage.title }}"
          class="w-full h-auto object-cover {{ imageRoundedClass }}">
      {% endif %}

      {% if smallImage %}
        {% set smallTransform = isCpOn ? thumb640Hfit : thumb640crop %}

        <div class="block md:hidden mt-4 {{ isImageLeft ? 'text-left' : 'text-right' }}">
          <img 
            src="{{ smallImage.getUrl(smallTransform) }}"
            alt="{{ smallImage.title }}"
            class="w-full h-auto rounded-xl">
        </div>

        <img 
          src="{{ smallImage.getUrl(smallTransform) }}"
          alt="{{ smallImage.title }}"
          class="hidden md:block absolute w-[40%] h-auto top-[80%] {{ isImageLeft ? 'left-10' : 'right-10' }} rounded-xl">
      {% endif %}
    </div>

    {# ---- SZÖVEGES BLOKK ---- #}
    <div class="w-full {{ textWidthClass }} pt-8 sm:pt-12 sm:p-12 {{ textOrder }}">

      {% if block.title %}
        <h2 class="text-3xl sm:text-6xl mb-4">{{ block.title }}</h2>
      {% endif %}

      {% if block.subTitle %}
        <h3 class="text-2xl sm:text-3xl mb-4 text-secondary">{{ block.subTitle }}</h3>
      {% endif %}

      {# =============================== #}
      {#      GOMB MÁTRIX – ÚJ HELY      #}
      {#    SUBTITLE ÉS TEXTBOX KÖZÖTT   #}
      {# =============================== #}

      {% set buttons = block.buttons.all() %}

      {% if buttons|length %}
        <div class="flex flex-wrap gap-3 mt-2 mb-6">

          {% for btn in buttons %}
            {% set url = btn.lButton ?? '#' %}
            {% set txt = btn.nButton ?? '' %}

            <a href="{{ url }}"
              class="px-5 py-2 border border-primary text-primary text-base rounded-full
                      bg-white transition-colors duration-200
                      hover:bg-primary hover:text-white">
              {{ txt }}
            </a>
          {% endfor %}

        </div>
      {% endif %}

      {# ---- TEXTBOX MOST EZUTÁN JÖN ---- #}
      {% if block.textBox %}
        <div class="prose max-w-none mb-4 [&_h3]:text-lg [&_h3]:sm:text-2xl [&_li]:list-disc [&_li]:list-outside [&_li]:ml-10 [&_li]:mt-1">
          {{ block.textBox | raw }}
        </div>
      {% endif %}

      {# Opcionális egyedi egygombos régi megoldás – ha kell #}
    {% set entryButton = block.button.one() %}
    {% if entryButton %}
      <div class="my-2">
        <a href="{{ entryButton.url }}"
          class="bg-primary text-white px-6 py-3 rounded-full inline-flex items-center gap-2 
                  font-semibold transition-transform duration-300
                  hover:scale-110">
          {{ entryButton.title }}
          <span class="w-4 h-4 [&_svg]:w-full [&_svg]:h-full">
            {% include 'includes/icons/heroicons/arrow-right.svg' %}
          </span>
        </a>
      </div>
    {% endif %}

    </div>

  </div>
</div>
{% endif %}
