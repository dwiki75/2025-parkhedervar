{% if block.type == 'threePictAdd' %}

    <div class="max-w-8xl mx-auto"> 
        
        {% if block.title %}
            <h2 class="text-2xl mb-4">{{ block.title }}</h2>
        {% endif %}

        <div class="flex gap-4 sm:gap-6">
            {% for pic in block.threePict.all() %}
           
                <div class="flex-1">
                        <img 
                            src="{{ pic.getUrl(thumb640Hfit) }}" 
                            alt="{{ pic.title }}"
                            class="w-full h-auto rounded-xl"
                        />
                </div>
            {% endfor %}
        </div>

    </div>
{% endif %}
