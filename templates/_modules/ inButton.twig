{% if block.type == 'bpT' %}
    {% set url = block.lButton ?? '#' %}
    {% set text = block.nButton ?? '' %}

    <div class="inline-flex">
      <a href="{{ url }}"
        class="inline-block px-6 py-3 border border-primary text-primary text-lg rounded-full
                bg-white transition-colors duration-200
                hover:bg-primary hover:text-white">
        {{ text }}
      </a>
    </div>
{% endif %}